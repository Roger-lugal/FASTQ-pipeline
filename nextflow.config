manifest {
    name            = 'FASTQ DMS Pipeline'
    description     = 'Deep Mutational Scanning analysis from FASTQ libraries'
    author          = 'Your Name'
    version         = '1.0.0'
}

params {
    output = 'results'
    variant_start = 0
    variant_end = null
    min_length = 1
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail', '-c']
    cpus = 2
    memory = '4 GB'
    time = '2h'
}

profiles {
    local {
        process.executor = 'local'
        docker.enabled = false
        singularity.enabled = false
        workDir = 'work'
    }

    slurm {
        process.executor = 'slurm'
        process.queue = 'normal'
        process.clusterOptions = '--mem-per-cpu=4G'
        process.cpus = 4
        process.memory = '8 GB'
        process.time = '12h'
        workDir = 'work'
    }

    aws {
        process.executor = 'awsbatch'
        process.queue = 'default'
        process.container = 'python:3.11-slim'
        docker.enabled = false
        singularity.enabled = false
        aws {
            region = 'eu-west-1'
            batch.cliPath = '/usr/local/bin/aws'
        }
        workDir = 's3://my-bucket/fastq-dms/work'
    }

    gcp {
        process.executor = 'google-batch'
        process.container = 'python:3.11-slim'
        process.cpus = 4
        process.memory = '8 GB'
        google {
            project = 'my-gcp-project'
            location = 'europe-west1'
        }
        workDir = 'gs://my-bucket/fastq-dms/work'
    }
}

aws {
    batch {
        cliPath = '/usr/local/bin/aws'
    }
}

docker {
    enabled = false
}

singularity {
    enabled = false
}
